{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FT02 Field Manual Card Schema v1",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "priority",
    "trigger",
    "immediate_actions",
    "steps",
    "stop_or_escalate",
    "do_not",
    "completion_check",
    "source_refs",
    "review"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{3}-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 2
    },
    "category": {
      "type": "string"
    },
    "priority": {
      "enum": [
        "critical",
        "high",
        "normal"
      ]
    },
    "quick_access": {
      "type": "boolean"
    },
    "trigger": {
      "type": "string"
    },
    "immediate_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_or_escalate": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "do_not": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "completion_check": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "type": "object",
      "required": [
        "status",
        "last_reviewed"
      ]
    }
  }
}